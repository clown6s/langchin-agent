# 一、LLM（核心）
# ---------------------------------------------------------------------------
# OpenAI 兼容的 Chat 端点（SiliconFlow / DeepSeek 均可）。
LC_LLM_BASE_URL=https://api.deepseek.com/v1
# 调用密钥（必填，留空则无法发起请求）。
LC_LLM_API_KEY=
# 模型名。DeepSeek 用 deepseek-chat；SiliconFlow 用对应模型 ID。
LC_LLM_MODEL=deepseek-chat
# 采样温度（0-1，越小越确定）。
LC_LLM_TEMPERATURE=0.2
# 单次生成最大 token 数。
LC_LLM_MAX_TOKENS=1024

# Agent 最多工具调用迭代轮数（防止无限循环）。
LC_MAX_ITERATIONS=6

# ---------------------------------------------------------------------------
# 二、数据访问（固定走 MySQL）
# ---------------------------------------------------------------------------
# 元数据连接：用于读取已登记的数据域 / 表 / 列 / 权限（可查询）。
LC_MYSQL_HOST=127.0.0.1
LC_MYSQL_PORT=3306
LC_MYSQL_USER=
LC_MYSQL_PASSWORD=
LC_MYSQL_DATABASE=

# 业务查询连接：只读账号，只能读取已授权业务表（与元数据账号分离）。
# 缺省时回退到上面的 LC_MYSQL_* 以兼容旧配置；建议单独配置只读账号。
LC_QUERY_MYSQL_HOST=
LC_QUERY_MYSQL_PORT=
LC_QUERY_MYSQL_USER=
LC_QUERY_MYSQL_PASSWORD=
LC_QUERY_MYSQL_DATABASE=

# ---------------------------------------------------------------------------
# 三、企业知识库 RAG（enable_rag=True 时生效，可整段不配 = 不启用 RAG）
# ---------------------------------------------------------------------------
# ---- Embedding（OpenAI 兼容 /embeddings）----
LC_EMBEDDING_BASE_URL=
LC_EMBEDDING_API_KEY=
LC_EMBEDDING_MODEL=
# 向量维度，必须与 Milvus 集合一致。
LC_EMBEDDING_DIM=4096

# ---- Rerank（OpenAI 兼容 /rerank；缺省复用 embedding 的 url/key）----
LC_RERANK_BASE_URL=
LC_RERANK_API_KEY=
LC_RERANK_MODEL=

# ---- Milvus（向量库）----
LC_MILVUS_HOST=127.0.0.1
LC_MILVUS_PORT=19530
# 认证二选一：优先 token；否则用 user+password。
LC_MILVUS_TOKEN=
LC_MILVUS_USER=
LC_MILVUS_PASSWORD=
LC_MILVUS_DB=
LC_MILVUS_COLLECTION=

# ---- Elasticsearch（词法检索）----
LC_ES_HOST=
LC_ES_USERNAME=
LC_ES_PASSWORD=
# ES HTTPS 证书指纹（可选，用于固定证书）。
LC_ES_CERT_FINGERPRINT=
LC_ES_INDEX=

# ---- 检索参数（也可用无前缀别名 RECALL_K / RERANK_K / TOP_K）----
# 召回的候选条数（dense+lexical 各自）
LC_RECALL_K=100
# 重排输入条数上限
LC_RERANK_K=100
# 最终返回给 LLM 的条数
LC_TOP_K=5

# ---------------------------------------------------------------------------
# 四、可观测性（注意：这些由 os.getenv 读取，需设为真实环境变量才生效，
#     写在 .env 里不会被读取）
# ---------------------------------------------------------------------------
# ENV=dev              # dev|prod；prod 时日志输出 JSON
# LOG_LEVEL=INFO       # 日志级别
# OTEL_SERVICE_NAME=langchin-agent
# OTEL_EXPORTER_OTLP_ENDPOINT=   # 非空则开启 OTLP 链路导出